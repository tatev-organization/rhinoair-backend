model BusinessInformation {
  businessInformationId String     @id @default(uuid())
  businessName          String
  businessCategory      String
  website               String?
  competitor            String?
  rating                Float?
  review                String?
  locations             Location[]
  userId                String
  user                  User                @relation(fields: [userId], references: [userId], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([businessCategory])
  @@index([businessName])
}

model Location {
  locationId            String              @id @default(uuid())
  url                   String
  address               String
  businessInformationId String
  businessInformation   BusinessInformation @relation(fields: [businessInformationId], references: [businessInformationId], onDelete: Cascade)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([address])
}
