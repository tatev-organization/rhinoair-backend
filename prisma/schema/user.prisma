model User {
    userId    String   @id @default(uuid())
    email     String   @unique
    password  String
    name      String
    role      Role     @default(USER)
    status    Status   @default(TRIAL)
    updatedAt DateTime @updatedAt
    createAt  DateTime @default(now())

    googleAuth        Boolean   @default(false)
    language          String?
    profileImage      String?
    operationsRole    String?
    otp               Int?
    isVerified        Boolean   @default(false)
    refreshToken      String?
    resetToken        String?
    resetTokenExpires DateTime?

    businessInformation  BusinessInformation[]
    notifications        Notification[]
    supportTickets       SupportTicket[]       @relation("SupportTicketUsers")
    cardInfo             CardInfo?
    subscriptions        Subscription[]
    notificationSettings NotificationSettings?

    @@index([operationsRole])
    @@index([name])
    @@index([googleAuth])
}

model NotificationSettings {
    notificationSettingsId String @id @default(cuid())
    userId                 String @unique

    emailMonthlyReports  Boolean  @default(true)
    emailImportantAlerts Boolean  @default(true)
    emailWeeklySummary   Boolean  @default(true)
    inAppNegativeReview  Boolean  @default(true)
    inAppRatingDrop      Boolean  @default(true)
    inAppMonthlyReport   Boolean  @default(true)
    updatedAt            DateTime @updatedAt
    createAt             DateTime @default(now())

    user User @relation(fields: [userId], references: [userId], onDelete: Cascade)
}
